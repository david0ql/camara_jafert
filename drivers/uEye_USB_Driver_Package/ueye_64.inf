[Version]
Signature           = $Windows NT$
Class               = USB
ClassGuid           = {36FC9E60-C465-11CF-8056-444553540000} 
Provider            = %IDS%
DriverVer           = 08/03/2012, 4.2.11.0
CatalogFile.ntamd64 = uEye_64.cat

 
;==========================================
; Source file information
;==========================================

[DestinationDirs]
UEYE.CopyFiles.sys      = 12    ; %windir%\system32\drivers
UEYE.CopyFiles.dll      = 11    ; %windir%\system32
UEYE_BOOT.CopyFiles.sys = 12    ; %windir%\system32\drivers
UEYE_BOOT.CopyFiles.dll = 11    ; %windir%\system32


[SourceDisksNames]
1 = %uEyeInstallationMedia%,,,\drivers
2 = %uEyeInstallationMedia%,,,


[SourceDisksFiles]
ueye_usb_64.sys   = 1
ueye_boot_64.sys  = 1
ueye_api_64.dll   = 2
ueye_tools_64.dll = 2

;==========================================
; driver information
;==========================================

[Manufacturer]
%IDS% = IDSGMBH, ntamd64

