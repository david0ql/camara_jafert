CopyFiles = UEYE_BOOT.CopyFiles.sys, UEYE_BOOT.CopyFiles.dll


[UEYE_BOOT.AddReg]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,uEye_boot_64.sys


[UEYE_BOOT.CopyFiles.sys]
ueye_boot_64.sys,,,4
ueye_usb_64.sys,,,4


[UEYE_BOOT.CopyFiles.dll]
ueye_api_64.dll,,,4
ueye_tools_64.dll,,,4


[UEYE_BOOT.Dev.Services] 		
Addservice = ueye_boot,  0x00000002, UEYE_BOOT.AddService, UEYE_BOOT.EventLog.Inst


[UEYE_BOOT.Dev.NT.Services]
Addservice = ueye_boot,  0x00000002, UEYE_BOOT.AddService, UEYE_BOOT.EventLog.Inst


[UEYE_BOOT.AddService]
DisplayName    = %UEYE_BOOT.SvcDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\uEye_boot_64.sys
LoadOrderGroup = Extended Base
AddReg         = UEYE_BOOT_SERVICE.AddReg


[UEYE_BOOT_SERVICE.AddReg]
HKR,"Parameters","Devices",%REG_DWORD%,0
HKR,"Parameters","EventLogLevel",%REG_DWORD%, 2

[UEYE_BOOT.EventLog.Inst]
