;==========================================
; General installation section
;==========================================

[UEYE.Dev]
AddReg    = UEYE.AddReg
CopyFiles = UEYE.CopyFiles.sys, UEYE.CopyFiles.dll


[UEYE.Dev.NT]
AddReg    = UEYE.AddReg
CopyFiles = UEYE.CopyFiles.sys, UEYE.CopyFiles.dll


[UEYE.AddReg]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,uEye_usb_64.sys


[UEYE.CopyFiles.sys]
ueye_boot_64.sys,,,4
ueye_usb_64.sys,,,4


[UEYE.CopyFiles.dll]
ueye_api_64.dll,,,4
ueye_tools_64.dll,,,4


;==========================================
; Service Installation
;==========================================

[UEYE.Dev.Services] 		
AddService = ueye,  0x00000002, UEYE.AddService, UEYE.EventLog.Inst

[UEYE.Dev.NT.Services]
AddService = ueye,  0x00000002, UEYE.AddService, UEYE.EventLog.Inst


[UEYE.AddService]
DisplayName    = %UEYE.SvcDesc%
ServiceType    = 1                     ; SERVICE_KERNEL_DRIVER
StartType      = 3                     ; SERVICE_DEMAND_START
ErrorControl   = 1                     ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\uEye_usb_64.sys  ; Pfadname der SYS-Datei
LoadOrderGroup = Extended Base
AddReg         = UEYE_SERVICE.AddReg

[UEYE_SERVICE.AddReg]
HKR,"Parameters","Devices",%REG_DWORD%,0
HKR,"Parameters","EventLogLevel",%REG_DWORD%, 2

[UEYE.EventLog.Inst]
AddReg = UEYE.EventLog.AddReg

[UEYE.EventLog.AddReg]
HKR,,EventMessageFile,0x00020000,"%%SystemRoot%%\System32\IoLogMsg.dll;%%SystemRoot%%\System32\drivers\ueye_usb_64.sys"
HKR,,TypesSupported,0x00010001,7



