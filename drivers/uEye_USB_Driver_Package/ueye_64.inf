;==========================================
; BOOT sections
;==========================================
[UEYE_BOOT.Dev]
AddReg = UEYE_BOOT.AddReg
CopyFiles = UEYE_BOOT.CopyFiles.sys, UEYE_BOOT.CopyFiles.dll


[UEYE_BOOT.Dev.NT]
